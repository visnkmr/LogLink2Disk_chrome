{
    "name": "Save to history_local",
    "version": "2.0",
    "manifest_version": 2,
    "background": {
        "scripts": ["dist/background.js"]
    },
    "browser_action": {
        "default_title": "Save to history_local"
    },
    "permissions": [
        "tabs",
        "activeTab",
        "<all_urls>"
    ],
    "author": "Vishnu N K",
